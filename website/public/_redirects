# Netlify redirects. One-to-one rules live in src/redirects.ts; this file is
# for the ones Astro cannot emit as a static HTML page.

# Astro splits the sitemap into an index plus one file; the previous site
# served a single sitemap.xml.
/sitemap.xml  /sitemap-index.xml  301

# The blog no longer classifies posts by tag. `/blog/tags` itself is in
# src/redirects.ts, so it also works in dev; the wildcard can only live here.
/blog/tags/*  /blog  301
