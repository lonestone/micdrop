---
// Top navigation: brand on the left, sections next to it, search / theme /
// repository on the right, and a burger on mobile that mirrors the desktop nav
// plus the page sidebar into a panel.
//
// The bar sits on the page background rather than on its own surface, so the
// blur actually reads and the grid behind the hero runs under it instead of
// being cut off. The persistent frames, the docs sidebar and the mobile
// drawer, keep their own surface: they are structure, not something scrolling
// content passes behind.
import config from '../../website.config'
import { mainNav } from '../navigation'
import GithubMark from './GithubMark.astro'
import Logo from './Logo.astro'
import NavLink from './NavLink.astro'
import SearchButton from './SearchButton.astro'
import ThemeToggle from './ThemeToggle.astro'

const controlClass =
  'flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg text-text-secondary transition-colors hover:bg-bg-elevated hover:text-text-main'
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg-main/75 backdrop-blur-md"
>
  <div class="flex h-14 items-center gap-4 px-4 sm:gap-6 sm:px-6">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 no-underline hover:no-underline"
    >
      <Logo class="text-xl" />
      <span class="text-[15px] font-semibold tracking-tight text-text-main">
        {config.siteName}
      </span>
    </a>

    <nav class="hidden min-w-0 gap-1 md:flex" data-nav>
      {
        mainNav.map((link) => (
          <NavLink path={link.href} match={link.match}>
            {link.label}
          </NavLink>
        ))
      }
    </nav>

    <div class="hidden min-w-0 flex-1 md:block"></div>

    <div class="hidden shrink-0 items-center gap-1 md:flex" data-right>
      <SearchButton />
      {/* Separates what searches the site from what configures it. Dropped
          from the mobile clone, where the row is laid out differently. */}
      <span
        class="mx-1.5 h-5 w-px shrink-0 bg-border"
        data-nav-separator
        aria-hidden="true"
      />
      <ThemeToggle />
      <a
        href={config.github}
        target="_blank"
        rel="noopener noreferrer"
        class={controlClass}
        aria-label="Micdrop on GitHub"
      >
        <GithubMark />
      </a>
    </div>

    <button
      class:list={['-mr-1 ml-auto md:hidden', controlClass]}
      data-burger
      aria-label="Menu"
      aria-expanded="false"
    >
      <svg
        class="block h-5 w-5"
        data-icon="open"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg
        class="hidden h-5 w-5"
        data-icon="close"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel, populated at runtime from the desktop nav + sidebar -->
  <div
    class="hidden h-[calc(100dvh-57px)] overflow-y-auto border-t border-border bg-bg-secondary md:hidden"
    data-mobile-menu
  >
  </div>
</header>

<script>
  import { mountDocSearch } from '../scripts/docsearch'

  const header = document.querySelector('header')!
  const burger = header.querySelector('[data-burger]') as HTMLElement
  const menu = header.querySelector('[data-mobile-menu]') as HTMLElement
  const iconOpen = header.querySelector("[data-icon='open']") as HTMLElement
  const iconClose = header.querySelector("[data-icon='close']") as HTMLElement
  const desktopNav = header.querySelector('[data-nav]') as HTMLElement
  const desktopRight = header.querySelector('[data-right]') as HTMLElement

  // The controls come first in the drawer: on a phone, search is what the panel
  // is opened for most of the time, so it takes the width that is left and the
  // two settings sit next to it. The desktop separator has nothing to separate
  // here and goes.
  const mobileRight = desktopRight.cloneNode(true) as HTMLElement
  mobileRight.className =
    'flex items-center gap-2 border-b border-border px-3 py-3'
  mobileRight.removeAttribute('data-right')
  mobileRight.querySelector('[data-nav-separator]')?.remove()
  mobileRight.querySelector('[data-docsearch]')?.classList.add('min-w-0', 'flex-1')
  // The clone carries the rendered search button without its listeners; reset
  // it so DocSearch can claim it as a fresh container.
  mobileRight
    .querySelectorAll<HTMLElement>('[data-docsearch]')
    .forEach((el) => delete el.dataset.mounted)
  menu.appendChild(mobileRight)
  mountDocSearch()

  const mobileNav = desktopNav.cloneNode(true) as HTMLElement
  mobileNav.className = 'flex flex-col gap-0.5 px-3 py-3'
  mobileNav.removeAttribute('data-nav')
  menu.appendChild(mobileNav)

  // If the page has a docs sidebar, clone it into the mobile menu too.
  const desktopSidebar = document.querySelector('[data-sidebar]') as HTMLElement | null
  if (desktopSidebar) {
    const mobileSidebar = desktopSidebar.cloneNode(true) as HTMLElement
    mobileSidebar.className = 'border-t border-border px-3 pt-3 pb-10'
    mobileSidebar.removeAttribute('data-sidebar')
    // Groups start collapsed in the drawer; open the branch leading to the page.
    mobileSidebar
      .querySelectorAll('details')
      .forEach((el) => el.toggleAttribute('open', el.hasAttribute('open')))
    menu.appendChild(mobileSidebar)
  }

  function handleBurgerClick() {
    const isOpen = !menu.classList.contains('hidden')
    menu.classList.toggle('hidden', isOpen)
    iconOpen.classList.toggle('hidden', !isOpen)
    iconOpen.classList.toggle('block', isOpen)
    iconClose.classList.toggle('hidden', isOpen)
    iconClose.classList.toggle('block', !isOpen)
    burger.setAttribute('aria-expanded', String(!isOpen))
    document.body.classList.toggle('overflow-hidden', !isOpen)
  }

  function handleLinkClick() {
    if (!menu.classList.contains('hidden')) handleBurgerClick()
  }

  burger.addEventListener('click', handleBurgerClick)
  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', handleLinkClick)
  })
</script>
