---
// Top navigation: logo on the left, sections in the middle, search / theme /
// GitHub on the right, and a burger menu on mobile that mirrors the desktop nav
// plus the page sidebar into a panel.
import config from '../../website.config'
import { mainNav } from '../navigation'
import Logo from './Logo.astro'
import NavLink from './NavLink.astro'
import SearchButton from './SearchButton.astro'
import ThemeToggle from './ThemeToggle.astro'
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg-secondary/95 backdrop-blur-sm"
>
  <div class="flex h-14 items-center justify-between px-4 sm:px-6">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 no-underline hover:no-underline"
    >
      <Logo class="h-7 w-7" />
      <span class="text-lg font-bold text-text-main">{config.siteName}</span>
    </a>

    <div class="hidden flex-1 items-center gap-3 md:ml-6 md:flex lg:ml-10">
      <nav class="flex min-w-0 gap-1" data-nav>
        {
          mainNav.map((link) => (
            <NavLink path={link.href} match={link.match}>
              {link.label}
            </NavLink>
          ))
        }
      </nav>
      <div class="min-w-0 flex-1"></div>
      <div class="flex shrink-0 items-center gap-2" data-right>
        <SearchButton />
        <ThemeToggle />
        <a
          href={config.github}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md p-2 text-text-secondary transition-colors hover:bg-bg-elevated hover:text-text-main"
          aria-label="Micdrop on GitHub"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.1.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0C17.3 4.55 18.3 4.87 18.3 4.87c.66 1.65.25 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.58A11.99 11.99 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"
            />
          </svg>
        </a>
      </div>
    </div>

    <button
      class="-mr-2 cursor-pointer p-2 text-text-secondary md:hidden"
      data-burger
      aria-label="Menu"
      aria-expanded="false"
    >
      <svg
        class="block h-6 w-6"
        data-icon="open"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg
        class="hidden h-6 w-6"
        data-icon="close"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel, populated at runtime from the desktop nav + sidebar -->
  <div
    class="hidden h-[calc(100dvh-57px)] overflow-y-auto border-t border-border bg-bg-secondary md:hidden"
    data-mobile-menu
  >
  </div>
</header>

<script>
  import { mountDocSearch } from '../scripts/docsearch'

  const header = document.querySelector('header')!
  const burger = header.querySelector('[data-burger]') as HTMLElement
  const menu = header.querySelector('[data-mobile-menu]') as HTMLElement
  const iconOpen = header.querySelector("[data-icon='open']") as HTMLElement
  const iconClose = header.querySelector("[data-icon='close']") as HTMLElement
  const desktopNav = header.querySelector('[data-nav]') as HTMLElement
  const desktopRight = header.querySelector('[data-right]') as HTMLElement

  const mobileNav = desktopNav.cloneNode(true) as HTMLElement
  mobileNav.className = 'flex flex-col gap-1 px-6 pt-4'
  mobileNav.removeAttribute('data-nav')
  menu.appendChild(mobileNav)

  const mobileRight = desktopRight.cloneNode(true) as HTMLElement
  mobileRight.className = 'flex items-center gap-3 px-5 pt-3 pb-5'
  mobileRight.removeAttribute('data-right')
  // The clone carries the rendered search button without its listeners; reset
  // it so DocSearch can claim it as a fresh container.
  mobileRight
    .querySelectorAll<HTMLElement>('[data-docsearch]')
    .forEach((el) => delete el.dataset.mounted)
  menu.appendChild(mobileRight)
  mountDocSearch()

  // If the page has a docs sidebar, clone it into the mobile menu too.
  const desktopSidebar = document.querySelector('[data-sidebar]') as HTMLElement | null
  if (desktopSidebar) {
    const mobileSidebar = desktopSidebar.cloneNode(true) as HTMLElement
    mobileSidebar.className = 'border-t border-border px-6 pt-4 pb-8'
    mobileSidebar.removeAttribute('data-sidebar')
    // Groups start collapsed in the drawer; open the branch leading to the page.
    mobileSidebar
      .querySelectorAll('details')
      .forEach((el) => el.toggleAttribute('open', el.hasAttribute('open')))
    menu.appendChild(mobileSidebar)
  }

  function handleBurgerClick() {
    const isOpen = !menu.classList.contains('hidden')
    menu.classList.toggle('hidden', isOpen)
    iconOpen.classList.toggle('hidden', !isOpen)
    iconOpen.classList.toggle('block', isOpen)
    iconClose.classList.toggle('hidden', isOpen)
    iconClose.classList.toggle('block', !isOpen)
    burger.setAttribute('aria-expanded', String(!isOpen))
    document.body.classList.toggle('overflow-hidden', !isOpen)
  }

  function handleLinkClick() {
    if (!menu.classList.contains('hidden')) handleBurgerClick()
  }

  burger.addEventListener('click', handleBurgerClick)
  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', handleLinkClick)
  })
</script>
