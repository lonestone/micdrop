---
/**
 * The one-liner between the packages and the features. `code` is set apart in
 * the sentence, so it comes as its own prop rather than as markup.
 */
interface Props {
  before: string
  code: string
  after: string
  note: string
}

const { before, code, after, note } = Astro.props
---

<section class="container mx-auto px-4 text-center">
  <div
    class="text-2xl leading-relaxed font-bold text-ai-surface-800 md:text-3xl dark:text-ai-surface-100"
  >
    {before}{' '}<code
      class="rounded bg-ai-surface-200 px-2 py-1 text-xl text-ai-primary-600 md:text-2xl dark:bg-ai-surface-700 dark:text-ai-primary-400"
      >{code}</code
    >{' '}{after}
    <div
      class="mt-4 text-lg font-normal text-ai-surface-600 md:text-xl dark:text-ai-surface-400"
    >
      {note}
    </div>
  </div>
</section>
