---
/**
 * The package index, as a four cell bento. The grid spans are set here rather
 * than passed from the content, so the MDX file stays a list of groups: the
 * first cell is the widest because it is where a reader starts, and the two
 * provider groups share the second row.
 */
import HomeSection from './HomeSection.astro'

interface Props {
  title: string
  intro: string
}

const { title, intro } = Astro.props
---

<HomeSection title={title} intro={intro} band>
  <div
    class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-6 lg:[&>*:nth-child(1)]:col-span-4 lg:[&>*:nth-child(2)]:col-span-2 lg:[&>*:nth-child(3)]:col-span-3 lg:[&>*:nth-child(4)]:col-span-3"
  >
    <slot />
  </div>
</HomeSection>
