---
interface Props {
  title: string
  intro: string
}

const { title, intro } = Astro.props
---

<section class="container mx-auto px-4">
  <div class="mb-8 text-center">
    <h2 class="mt-0 mb-4 text-3xl font-bold">{title}</h2>
    <p class="mb-0 text-lg text-ai-surface-700 dark:text-ai-surface-300">{intro}</p>
  </div>

  <div class="mb-8 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
    <slot />
  </div>
</section>
