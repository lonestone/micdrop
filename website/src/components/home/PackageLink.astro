---
/**
 * One package, written the way it is installed. The name is the label: a
 * monospace chip that links to the page documenting it.
 */
interface Props {
  name: string
  href: string
}

const { name, href } = Astro.props
---

<a
  href={href}
  class="inline-flex items-center rounded-lg border border-border bg-bg-main/60 px-3 py-1.5 font-mono text-sm text-text-secondary no-underline transition-colors hover:border-primary hover:text-text-main hover:no-underline"
>
  {name}
</a>
