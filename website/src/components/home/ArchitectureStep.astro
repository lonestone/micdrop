---
/** One stage of the pipeline, under the animated diagram. */
interface Props {
  title: string
}

const { title } = Astro.props
---

<div class="border-t border-border pt-5">
  <h3 class="mt-0 mb-2 text-base font-semibold text-text-main">{title}</h3>
  <p class="mb-0 text-sm leading-relaxed text-text-secondary">
    <slot />
  </p>
</div>
