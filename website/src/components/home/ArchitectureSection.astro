---
/**
 * "How it works": the animated pipeline, with the three stages it draws listed
 * underneath (see `ArchitectureStep`).
 */
import ArchitectureVisualization from './ArchitectureVisualization.astro'
import HomeSection from './HomeSection.astro'

interface Props {
  title: string
  intro: string
}

const { title, intro } = Astro.props
---

<HomeSection title={title} intro={intro}>
  <div class="reveal rounded-xl border border-border bg-bg-secondary p-4 sm:p-8">
    <ArchitectureVisualization />
  </div>

  <div class="reveal mt-12 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-10">
    <slot />
  </div>
</HomeSection>
