---
/**
 * What the library gets used for, as a ruled index in two columns: the titles
 * carry the whole idea, and the rows that have somewhere to read more end on a
 * button. Two columns rather than one long list, so nine entries stay a glance
 * instead of a scroll.
 */
import HomeSection from './HomeSection.astro'

interface Props {
  title: string
  intro: string
}

const { title, intro } = Astro.props
---

<HomeSection title={title} intro={intro}>
  {/* The last entry runs the full width: it is the one that closes the list
      rather than another thing to build, and a half row with nothing beside it
      would read as a gap. */}
  <div
    class="reveal grid grid-cols-1 md:grid-cols-2 md:gap-x-14 md:[&>*:last-child]:col-span-2"
  >
    <slot />
  </div>
</HomeSection>
