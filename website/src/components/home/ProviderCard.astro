---
/** One European AI provider, linking to its integration page. */
interface Props {
  name: string
  role: string
  href: string
}

const { name, role, href } = Astro.props
---

<a href={href} class="ai-card group text-center hover:no-underline">
  <h3
    class="mt-0 mb-1 text-xl font-bold group-hover:text-ai-primary-500 dark:text-ai-primary-300 dark:group-hover:text-ai-primary-400"
  >
    {name}
  </h3>
  <p class="mb-2 text-sm font-medium text-ai-primary-600 dark:text-ai-primary-400">
    {role}
  </p>
  <p class="mb-0 text-sm text-ai-surface-700 dark:text-ai-surface-300">
    <slot />
  </p>
</a>
