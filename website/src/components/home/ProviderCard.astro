---
/** One European AI provider, as a row linking to its integration page. */
interface Props {
  name: string
  role: string
  href: string
}

const { name, role, href } = Astro.props
---

<a
  href={href}
  class="group flex flex-col gap-1 border-b border-border py-5 no-underline hover:no-underline sm:flex-row sm:gap-8"
>
  <span
    class="font-semibold text-text-main transition-colors group-hover:text-primary sm:w-36 sm:shrink-0"
  >
    {name}
  </span>
  <span class="flex-1">
    <span class="block font-mono text-xs text-primary">{role}</span>
    <span class="mt-1 block text-sm text-text-secondary"><slot /></span>
  </span>
</a>
