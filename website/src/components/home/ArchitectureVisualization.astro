---
/**
 * Animated map of the pipeline: audio leaves the mic, crosses the client and
 * the server, goes through STT, agent and TTS, and comes back to the speaker.
 * Particles travel along the connections on a ten second loop, and each block
 * flashes as data reaches it.
 */

const WIDTH = 800
const HEIGHT = 250
const PADDING = 10

const blocks = [
  {
    id: 'microphone',
    label: '🎙️ Mic',
    x: 100 / 2 + PADDING,
    y: HEIGHT * 0.3,
    width: 100,
    height: 40,
    color: '#715603',
    flashColor: '#EAB308',
  },
  {
    id: 'speaker',
    label: '🔈 Speaker',
    x: 100 / 2 + PADDING,
    y: HEIGHT * 0.7,
    width: 100,
    height: 40,
    color: '#715603',
    flashColor: '#EAB308',
  },
  {
    id: 'client',
    label: 'Client',
    x: WIDTH * 0.33,
    y: HEIGHT * 0.5,
    width: 120,
    height: 60,
    color: '#10B981',
  },
  {
    id: 'server',
    label: 'Server',
    x: WIDTH * 0.66,
    y: HEIGHT * 0.5,
    width: 120,
    height: 60,
    color: '#10B981',
  },
  {
    id: 'stt',
    label: 'STT',
    x: WIDTH - 80 / 2 - PADDING,
    y: 40 / 2 + PADDING,
    width: 80,
    height: 40,
    color: '#133976',
    flashColor: '#3B82F6',
  },
  {
    id: 'agent',
    label: 'Agent',
    x: WIDTH - 80 / 2 - PADDING,
    y: HEIGHT * 0.5,
    width: 80,
    height: 40,
    color: '#133976',
    flashColor: '#3B82F6',
  },
  {
    id: 'tts',
    label: 'TTS',
    x: WIDTH - 80 / 2 - PADDING,
    y: HEIGHT - 40 / 2 - PADDING,
    width: 80,
    height: 40,
    color: '#133976',
    flashColor: '#3B82F6',
  },
]

const at = (id: string) => blocks.find((block) => block.id === id)!

const connections = [
  ['microphone', 'client'],
  ['client', 'server'],
  ['server', 'stt'],
  ['stt', 'server'],
  ['server', 'agent'],
  ['agent', 'server'],
  ['server', 'tts'],
  ['server', 'client'],
  ['tts', 'server'],
  ['client', 'speaker'],
].map(([from, to]) => ({
  from,
  to,
  path: `M ${at(from).x} ${at(from).y} L ${at(to).x} ${at(to).y}`,
}))
---

<div class="relative w-full overflow-hidden rounded-xl bg-transparent">
  <svg
    class="w-full"
    viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-label="Audio flows from the microphone to the client, then to the server, through speech-to-text, the AI agent and text-to-speech, and back to the speaker."
    data-architecture
  >
    <defs>
      <filter id="particle-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="coloredBlur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="coloredBlur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    {
      connections.map((connection, index) => (
        <path
          d={connection.path}
          stroke="#6C799051"
          stroke-width="3"
          fill="none"
          opacity="0.8"
          data-connection={index}
        />
      ))
    }

    <g data-particles></g>

    {
      blocks.map((block) => (
        <g>
          <rect
            x={block.x - block.width / 2}
            y={block.y - block.height / 2}
            width={block.width}
            height={block.height}
            rx="8"
            fill={block.color}
            class="transition-all duration-200"
            data-block={block.id}
            data-color={block.color}
            data-flash={block.flashColor ?? block.color}
          />
          <text
            x={block.x}
            y={block.y + 5}
            text-anchor="middle"
            class="pointer-events-none fill-white font-bold"
            style="font-size:14px"
          >
            {block.label}
          </text>
        </g>
      ))
    }
  </svg>

  <div class="absolute bottom-4 left-4 text-xs text-ai-surface-600 dark:text-ai-surface-400">
    <div class="flex flex-wrap items-center gap-4">
      <div class="flex items-center gap-1">
        <span class="h-2 w-2 rounded-full bg-yellow-500"></span>
        <span>Audio</span>
      </div>
      <div class="flex items-center gap-1">
        <span class="h-2 w-2 rounded-full bg-blue-500"></span>
        <span>Message chunks</span>
      </div>
      <div class="flex items-center gap-1">
        <span class="h-3 w-3 rounded-full bg-blue-500"></span>
        <span>Messages</span>
      </div>
    </div>
  </div>
</div>

<script>
  const svg = document.querySelector<SVGSVGElement>('[data-architecture]')

  if (svg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const NS = 'http://www.w3.org/2000/svg'
    const layer = svg.querySelector<SVGGElement>('[data-particles]')!
    const paths = Array.from(
      svg.querySelectorAll<SVGPathElement>('[data-connection]')
    )
    const blocks = new Map(
      Array.from(svg.querySelectorAll<SVGRectElement>('[data-block]')).map(
        (rect) => [rect.dataset.block!, rect]
      )
    )

    // One pass of the conversation: which connection carries what, when.
    // Delays are milliseconds from the start of the loop; a particle leaves
    // every 150ms.
    const sequence = [
      { connection: 0, count: 4, kind: 'audio', delay: 0 },
      { connection: 1, count: 4, kind: 'audio', delay: 700 },
      { connection: 2, count: 4, kind: 'audio', delay: 1500 },
      { connection: 3, count: 5, kind: 'chunk', delay: 2200 },
      { connection: 4, count: 1, kind: 'message', delay: 3400 },
      { connection: 5, count: 7, kind: 'chunk', delay: 4400 },
      { connection: 6, count: 7, kind: 'chunk', delay: 5000 },
      { connection: 7, count: 1, kind: 'message', delay: 5900 },
      { connection: 8, count: 5, kind: 'audio', delay: 5600 },
      { connection: 7, count: 5, kind: 'audio', delay: 6700 },
      { connection: 9, count: 5, kind: 'audio', delay: 7300 },
    ]

    // Which block lights up when a particle lands on a given connection.
    const arrivals: Record<number, string> = {
      2: 'stt',
      4: 'agent',
      6: 'tts',
      9: 'speaker',
    }

    const lengths = paths.map((path) => path.getTotalLength())
    const flashUntil = new Map<string, number>()

    interface Particle {
      connection: number
      progress: number
      kind: string
      circle: SVGCircleElement
    }

    let particles: Particle[] = []
    let emitted = new Set<string>()
    let elapsed = 0
    let last = performance.now()

    const spawn = (connection: number, kind: string) => {
      const circle = document.createElementNS(NS, 'circle')
      circle.setAttribute('r', kind === 'message' ? '12' : '6')
      circle.setAttribute('fill', kind === 'audio' ? '#EAB308' : '#3B82F6')
      circle.setAttribute('filter', 'url(#particle-glow)')
      layer.appendChild(circle)
      particles.push({ connection, progress: 0, kind, circle })
    }

    const flash = (id: string, now: number) => flashUntil.set(id, now + 200)

    const frame = (now: number) => {
      const delta = now - last
      last = now
      elapsed += delta

      if (elapsed >= 10000) {
        elapsed = 0
        emitted.clear()
        particles.forEach((particle) => particle.circle.remove())
        particles = []
      }

      sequence.forEach((flow, index) => {
        const since = elapsed - flow.delay
        if (since < 0) return
        const slot = Math.floor(since / 150)
        const key = `${index}-${slot}`
        if (slot >= flow.count || emitted.has(key)) return
        emitted.add(key)
        spawn(flow.connection, flow.kind)
        if (flow.connection === 0) flash('microphone', now)
      })

      particles = particles.filter((particle) => {
        // 0.015 of the path per frame at 60fps, kept steady on other refresh
        // rates by scaling with the elapsed time.
        particle.progress += 0.015 * (delta / 16.7)
        if (particle.progress >= 0.9) {
          const target = arrivals[particle.connection]
          if (target) flash(target, now)
          particle.circle.remove()
          return false
        }
        const point = paths[particle.connection].getPointAtLength(
          particle.progress * lengths[particle.connection]
        )
        particle.circle.setAttribute('cx', String(point.x))
        particle.circle.setAttribute('cy', String(point.y))
        return true
      })

      blocks.forEach((rect, id) => {
        const lit = (flashUntil.get(id) ?? 0) > now
        rect.setAttribute('fill', lit ? rect.dataset.flash! : rect.dataset.color!)
      })

      requestAnimationFrame(frame)
    }

    requestAnimationFrame(frame)
  }
</script>
