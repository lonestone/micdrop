---
/**
 * The European stack pitch. The argument sits on the left and the providers
 * that make it true on the right, as a plain divided list: they are four
 * links, not four cards.
 */
import HomeSection from './HomeSection.astro'

interface Props {
  title: string
  intro: string
  note: string
  linkLabel: string
  linkHref: string
}

const { title, intro, note, linkLabel, linkHref } = Astro.props
---

<HomeSection band bare>
  <div
    class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-20"
  >
    <div class="reveal">
      <h2
        class="mt-0 mb-4 max-w-[18ch] text-3xl font-semibold tracking-tight text-balance text-text-main md:text-4xl"
      >
        {title}
      </h2>
      <p class="mb-4 max-w-[52ch] text-lg text-text-secondary">{intro}</p>
      <p class="mb-8 max-w-[52ch] text-text-secondary">{note}</p>
      <a
        href={linkHref}
        class="inline-flex items-center rounded-lg border border-primary px-5 py-2.5 font-medium whitespace-nowrap text-primary no-underline transition duration-200 hover:bg-ai-primary-500/10 hover:no-underline active:translate-y-px"
      >
        {linkLabel}
      </a>
    </div>

    <div class="reveal border-t border-border">
      <slot />
    </div>
  </div>
</HomeSection>
