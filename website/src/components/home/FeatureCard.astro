---
/** One selling point, under a rule that runs the width of its grid cell. */
interface Props {
  title: string
}

const { title } = Astro.props
---

<div class="reveal border-t border-border pt-6">
  <h3 class="mt-0 mb-3 text-xl font-semibold tracking-tight text-text-main">
    {title}
  </h3>
  <p class="mb-0 max-w-[68ch] leading-relaxed text-text-secondary">
    <slot />
  </p>
</div>
