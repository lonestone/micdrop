---
/**
 * The hero: the promise and the two entry points on the left, the code that
 * backs the promise on the right. The whole point of Micdrop is that the same
 * call runs on three surfaces, so the snippets are the illustration.
 */
import config from '../../../website.config'
import GithubMark from '../GithubMark.astro'
import HeroWaveform from './HeroWaveform.astro'
import HomeCode from './HomeCode.astro'

interface Props {
  title: string
  description: string
  primaryLabel: string
  primaryHref: string
  secondaryLabel: string
}

const { title, description, primaryLabel, primaryHref, secondaryLabel } =
  Astro.props
---

<header class="relative w-full overflow-hidden">
  <div
    class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_100%_75%_at_50%_0%,#000_5%,transparent_75%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative mx-auto grid w-full max-w-7xl grid-cols-1 gap-12 px-6 pt-16 pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:items-center lg:gap-16 lg:pt-24 lg:pb-28"
  >
    <div class="animate-rise">
      <h1
        class="mt-0 mb-6 text-4xl leading-[1.05] font-semibold tracking-tight text-balance text-text-main sm:text-5xl lg:text-6xl"
      >
        {title}
      </h1>
      <p class="mb-8 max-w-[44ch] text-lg text-text-secondary md:text-xl">
        {description}
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={primaryHref}
          class="inline-flex items-center rounded-lg bg-cta px-5 py-2.5 font-medium whitespace-nowrap text-on-cta no-underline transition duration-200 hover:brightness-110 hover:no-underline active:translate-y-px"
        >
          {primaryLabel}
        </a>
        <a
          href={config.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-bg-elevated px-5 py-2.5 font-medium whitespace-nowrap text-text-main no-underline transition duration-200 hover:border-text-secondary hover:no-underline active:translate-y-px"
        >
          <GithubMark class="h-4 w-4" />
          {secondaryLabel}
        </a>
      </div>
    </div>

    <div class="animate-rise w-full [animation-delay:140ms]">
      <HomeCode />
    </div>
  </div>

  {/* The band gets the same room above it as the first section leaves below,
      so the wave sits in the middle of the gap rather than under the hero. */}
  <div class="relative h-56 w-full md:h-72">
    <HeroWaveform />
  </div>
</header>
