---
/**
 * A family of packages, as one cell of the packages bento. `variant` picks the
 * cell's surface: the core group carries an emerald wash because it is the
 * entry point, the local models group carries the ruled grid because it runs
 * off the network, and the rest sit on the elevated surface.
 */
interface Props {
  title: string
  description: string
  variant: 'core' | 'ai' | 'local' | 'utility'
}

const { title, description, variant } = Astro.props

const surfaces = {
  core: 'border-ai-primary-500/30 bg-gradient-to-br from-ai-primary-500/12 to-transparent',
  ai: 'border-border bg-bg-elevated',
  local: 'border-border bg-bg-main',
  utility: 'border-border bg-bg-elevated',
}
---

<div
  class:list={[
    'reveal relative flex flex-col overflow-hidden rounded-xl border p-6 md:p-8',
    surfaces[variant],
  ]}
>
  {
    /* The grid sits on its own layer so the fade never touches the text. */
    variant === 'local' && (
      <div
        class="bg-grid pointer-events-none absolute inset-0 [mask-image:linear-gradient(to_bottom_right,#000_10%,transparent_80%)]"
        aria-hidden="true"
      />
    )
  }

  <h3 class="relative mt-0 mb-2 text-lg font-semibold text-text-main">{title}</h3>
  <p
    class="relative mt-0 mb-6 max-w-[46ch] text-sm leading-relaxed text-text-secondary"
  >
    {description}
  </p>
  <div class="relative mt-auto flex flex-wrap gap-2">
    <slot />
  </div>
</div>
