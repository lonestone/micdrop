---
/**
 * The selling points, grouped by rules rather than boxed in cards: the
 * packages bento above already carries the elevation, so this section works on
 * space and hairlines. The spans are uneven on purpose, so the eye reads five
 * points instead of scanning a repeating card.
 */
import HomeSection from './HomeSection.astro'

interface Props {
  title: string
  intro: string
}

const { title, intro } = Astro.props
---

<HomeSection title={title} intro={intro}>
  <div
    class="grid grid-cols-1 gap-x-10 gap-y-10 md:grid-cols-2 lg:grid-cols-6 lg:[&>*:nth-child(1)]:col-span-2 lg:[&>*:nth-child(2)]:col-span-4 lg:[&>*:nth-child(3)]:col-span-3 lg:[&>*:nth-child(4)]:col-span-3 lg:[&>*:nth-child(5)]:col-span-6"
  >
    <slot />
  </div>
</HomeSection>
