---
/**
 * One thing people build with Micdrop. Some of them have somewhere to read
 * more and some do not, so the row is never a link: when there is one, it is a
 * button at the end of the row.
 *
 * The row height is fixed rather than derived from its padding, so the rules
 * line up across the two columns whether or not a row carries a button.
 */
interface Props {
  title: string
  href?: string
  linkLabel?: string
  external?: boolean
}

const { title, href, linkLabel, external = false } = Astro.props
---

<div
  class="flex min-h-[4.5rem] items-center justify-between gap-6 border-t border-border"
>
  <h3 class="my-0 text-base font-medium text-text-main">{title}</h3>
  {
    href && (
      <a
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        class="shrink-0 rounded-lg border border-border px-3 py-1.5 text-sm whitespace-nowrap text-text-secondary no-underline transition-colors hover:border-primary hover:text-text-main hover:no-underline"
      >
        {linkLabel}
      </a>
    )
  }
</div>
