---
/**
 * The walkthrough video. `Youtube` loads the thumbnail only and injects the
 * iframe on click, so nothing reaches YouTube until a visitor asks for it.
 */
import HomeSection from './HomeSection.astro'
import Youtube from '../Youtube.astro'

interface Props {
  title: string
  intro: string
  videoId: string
}

const { title, intro, videoId } = Astro.props
---

<HomeSection title={title} intro={intro}>
  <div class="reveal">
    <Youtube videoId={videoId} class="mx-auto max-w-4xl border border-border" />
  </div>
</HomeSection>
