---
interface Props {
  title: string
  intro: string
  buttonLabel: string
  buttonHref: string
}

const { title, intro, buttonLabel, buttonHref } = Astro.props
---

<section class="container mx-auto max-w-3xl px-4">
  <div class="ai-card text-center">
    <h2 class="mt-0 mb-4 text-2xl font-bold">{title}</h2>
    <p class="mb-6 text-lg text-ai-surface-700 dark:text-ai-surface-300">{intro}</p>
    <a href={buttonHref} target="_blank" rel="noopener noreferrer" class="ai-button">
      {buttonLabel}
    </a>
  </div>
</section>
