---
import config from '../../website.config'
import { footerNav } from '../navigation'
import Logo from './Logo.astro'

const linkClass = 'no-underline hover:text-text-main hover:underline transition-colors'
---

<footer class="border-t border-border bg-bg-secondary px-6 py-12">
  <div class="mx-auto max-w-6xl">
    <div
      class="grid grid-cols-2 gap-8 text-sm text-text-secondary md:grid-cols-4"
    >
      <div class="col-span-2 flex flex-col gap-3 md:col-span-1">
        <a
          href="/"
          class="flex items-center gap-2 no-underline hover:no-underline"
        >
          <Logo class="text-xl" />
          <span class="text-lg font-bold text-text-main">{config.siteName}</span>
        </a>
        <p class="mb-0 max-w-xs">{config.tagline}</p>
      </div>

      {
        footerNav.map((column) => (
          <div class="flex flex-col gap-2">
            <span class="font-semibold text-primary">{column.title}</span>
            {column.links.map((link) => (
              <a
                href={link.href}
                class={linkClass}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>

    <p class="mt-10 mb-0 text-sm text-text-secondary">
      Made by <a href={config.author.href} class="text-text-secondary underline"
        >{config.author.label}</a
      > • MIT License
    </p>
  </div>
</footer>
