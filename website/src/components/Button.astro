---
interface Props {
  label: string
  href: string
  variant?: 'primary' | 'secondary' | 'outline'
  size?: 'sm' | 'md'
  class?: string
  targetBlank?: boolean
}

const {
  label,
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  targetBlank = false,
} = Astro.props

const sizeClasses = {
  sm: 'px-3 py-1.5 text-sm',
  md: 'px-5 py-2.5',
}

// `cta` carries its own foreground token, so the label keeps a comfortable
// contrast ratio on the emerald fill in both themes.
const variantClasses = {
  primary: 'bg-cta text-on-cta hover:brightness-110',
  secondary:
    'border border-border bg-bg-elevated text-text-main hover:border-text-secondary',
  outline: 'border border-primary text-primary hover:bg-ai-primary-500/10',
}
---

<a
  href={href}
  target={targetBlank ? '_blank' : undefined}
  rel={targetBlank ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-block rounded-lg font-medium whitespace-nowrap no-underline transition duration-200 hover:no-underline active:translate-y-px',
    sizeClasses[size],
    variantClasses[variant],
    className,
  ]}
>
  {label}
</a>
