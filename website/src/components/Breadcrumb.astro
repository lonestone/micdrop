---
import config from '../../website.config'
import { getCanonicalPath } from '../utils/getCanonicalPath'

export interface BreadcrumbSection {
  label: string
  href?: string
}

interface Props {
  category: string
  categoryUrl: string
  /** Groups between the category and the page, outermost first. */
  sections?: BreadcrumbSection[]
  title: string
  hideTitle?: boolean
  class?: string
}

const {
  category,
  categoryUrl,
  sections = [],
  title,
  hideTitle = false,
  class: className,
} = Astro.props

const linkClass = 'text-text-secondary hover:text-primary hover:underline transition-colors'
const origin = Astro.site?.origin ?? config.site
const trail = [
  { label: config.siteName, href: '/' },
  { label: category, href: categoryUrl },
  ...sections,
  { label: title, href: getCanonicalPath(Astro.url.pathname) },
]
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: `${origin}${item.href}` } : {}),
  })),
}
---

<nav class:list={['text-sm text-text-secondary', className]} aria-label="Breadcrumb">
  <a href="/" class={linkClass}>{config.siteName}</a>
  <span class="mx-1">›</span>
  <a href={categoryUrl} class={linkClass}>{category}</a>
  {
    sections.map((section) => (
      <>
        <span class="mx-1">›</span>
        {section.href ? (
          <a href={section.href} class={linkClass}>
            {section.label}
          </a>
        ) : (
          <span>{section.label}</span>
        )}
      </>
    ))
  }
  {
    !hideTitle && (
      <>
        <span class="mx-1">›</span>
        <span>{title}</span>
      </>
    )
  }
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
